# mario-golf-super-rush — example configuration.
# Copy to ".env" and fill in real values. NEVER commit your real .env.

# --- Golf NEX identity ---
# PLACEHOLDERS -- see main.go's package comment and README.md's "NEX identity" section for
# exactly why these aren't measured values yet (no kinnay wiki entry, no working game dump
# to extract from). A wrong access key fails SILENTLY at SYN, so don't expect anything in
# this server's logs until GOLF_ACCESS_KEY is the real value.
GOLF_ACCESS_KEY=00000000
GOLF_NEX_VERSION=40605

# --- Unverified wire-shape knobs (defaults = the modern Switch Pia 5.19+ profile, since
# --- Golf released June 2021, well past the cutover -- see main.go) ---
GOLF_STATION_SCHEME=prudps
GOLF_SECURE_MINOR=0
GOLF_LEGACY_PIA=0

# --- Network ---
# BARE IP the console will dial. NOT host:port — this becomes the station URL's "address"
# param and the port is set separately from SECURE_PORT. Set this to your own server's real
# public IP.
NEXTENDO_HOST=127.0.0.1
AUTH_PORT=8454
SECURE_PORT=60014
NEXTENDO_PROXY_PROTOCOL=0

# --- TLS (both endpoints terminate TLS themselves) ---
CERT_FILE=cert.pem
KEY_FILE=key.pem

# --- Nextendo account integration ---
NEXTENDO_ACCOUNT_URL=http://127.0.0.1:1
NEXTENDO_REQUIRE_ACCOUNT=0
NEXTENDO_REQUIRE_SIGNED_TOKEN=0

# --- Monitoring ---
# The dashboard is FAIL-CLOSED: with no token every /api request gets 403.
DASH_PORT=8090
DASH_TOKEN=change-me
NEXTENDO_SNI_HOST=

# --- Secrets (set these to strong random values in production) ---
NEXTENDO_INTERNAL_KEY=
NEXTENDO_SECRET=
NEXTENDO_SECRET_FILE=
NEXTENDO_SECURE_PASSWORD=securepasswordplz1
